# Neon Postgres (see README for pooled vs direct connection)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<dbname>?sslmode=require"

PORT=4000

# --- Azure AI Services — all three run on the always-free F0 tier ---
# Each is used automatically when its variables are set, and falls back to
# the mocked pipeline (server/mockAI.js) when they're not — you don't need
# all three configured to run the app. Check GET /api/health to see which
# are live vs mocked at any time. No Azure AI Foundry / LLM key is needed —
# see the "Azure AI Services" section in the README for why.

# Azure AI Speech (speech-to-text) — Keys and Endpoint page of your Speech resource
AZURE_SPEECH_KEY=<AZURE_SPEECH_KEY>
AZURE_SPEECH_REGION=<AZURE_SPEECH_REGION>

# Azure AI Language — Text Analytics for Health — Keys and Endpoint page of your Language resource
AZURE_LANGUAGE_KEY=<AZURE_LANGUAGE_KEY>
AZURE_LANGUAGE_ENDPOINT=https://<AZURE-LANGUAGE-RESOURCE>.cognitiveservices.azure.com

# Azure AI Translator — Keys and Endpoint page of your Translator resource
AZURE_TRANSLATOR_KEY=<AZURE_TRANSLATOR_KEY>
AZURE_TRANSLATOR_REGION=<AZURE_TRANSLATOR_REGION>

# --- Groq API (free tier — https://console.groq.com/keys) ---
# Used only to map a doctor's dictated transcript onto a hospital
# template's own free-text fields (Investigations, Diet, Miscellaneous,
# follow-up instructions, etc. — whatever fields don't map to a fixed
# clinical concept we already have exact data for). Optional: if unset,
# GET /api/health reports groqTemplateFieldMapping as NOT CONFIGURED and
# those fields fall back to keyword/regex matching against the transcript
# instead of an LLM call.
GROQ_API_KEY=<GROQ_API_KEY>
# Optional override — defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=openai/gpt-oss-120b
BLOB_WEBHOOK_PUBLIC_KEY=<BLOB_WEBHOOK_PUBLIC_KEY>
BLOB_STORE_ID=<BLOB_STORE_ID>